<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.cardgame.ui.controller.MenuPrincipalController"
           stylesheets="@../css/estilo_menu.css"
           pickOnBounds="false">

    <VBox fx:id="painelMenu"
          alignment="CENTER"
          spacing="22.0">

        <Label text="Prompt Cards" styleClass="titulo-jogo" />

        <Button fx:id="botaoNovoJogo"
                text="NOVO JOGO"
                onAction="#iniciarNovoJogo"
                styleClass="botao-menu"
                prefWidth="280" />

        <Button fx:id="botaoCarregarJogo"
                text="CARREGAR JOGO"
                onAction="#carregarJogo"
                styleClass="botao-menu"
                prefWidth="280" />

        <Button fx:id="botaoSair"
                text="SAIR"
                onAction="#sairDoJogo"
                styleClass="botao-menu"
                prefWidth="280" />

    </VBox>

</StackPane>