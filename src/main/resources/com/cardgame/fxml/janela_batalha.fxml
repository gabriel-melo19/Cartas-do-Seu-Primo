<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="768.0" prefWidth="1366.0" styleClass="root-batalha" stylesheets="@../css/estilo_batalha.css" xmlns="http://javafx.com/javafx/25.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cardgame.ui.controller.JanelaBatalhaController">

    <StackPane fx:id="camadaFundo" styleClass="camada-fundo-batalha" />

          <VBox fx:id="containerPrincipal" alignment="TOP_CENTER" maxWidth="1400.0" spacing="26.0" styleClass="container-principal-batalha">

              <padding>
            <Insets bottom="24.0" left="36.0" right="36.0" top="26.0" />
        </padding>

              <HBox alignment="CENTER" maxWidth="Infinity" styleClass="topo-batalha">
            <VBox alignment="CENTER_LEFT" spacing="4.0">
                <Label styleClass="hud-label" text="JOGADOR" />
                <Label fx:id="labelNomeJogador" styleClass="hud-nome" text="Antonio" />
            </VBox>

                  <Region HBox.hgrow="ALWAYS" />

                  <VBox alignment="CENTER" spacing="4.0">
                <Label fx:id="labelStatusTurno" styleClass="status-turno" text="Escolha uma carta da sua mão." />
            </VBox>

                  <Region HBox.hgrow="ALWAYS" />

                  <VBox alignment="CENTER_RIGHT" spacing="6.0">
                <ImageView fx:id="imageBotPerfil" fitHeight="74.0" fitWidth="74.0" pickOnBounds="true" preserveRatio="true" styleClass="imagem-bot-perfil" />
                <Label styleClass="hud-label" text="ADVERSÁRIO" />
                <Label fx:id="labelNomeBot" styleClass="hud-nome hud-nome-bot" text="Boss" />
            </VBox>
        </HBox>

              <VBox alignment="CENTER" prefHeight="31.0" prefWidth="1294.0" spacing="18.0" styleClass="arena-batalha-visual">

                  <HBox alignment="CENTER" spacing="42.0" styleClass="linha-cartas-topo">

                               <VBox alignment="CENTER" spacing="8.0">
                    <Label styleClass="titulo-slot" text="SUA CARTA" />
                    <StackPane fx:id="campoJogador" maxHeight="312.0" maxWidth="212.0" minHeight="312.0" minWidth="212.0" prefHeight="312.0" prefWidth="212.0" styleClass="slot-carta-batalha slot-carta-jogador">
                        <VBox alignment="CENTER" spacing="8.0">
                            <Label fx:id="labelCartaJogadorNome" styleClass="nome-carta-campo" text="Nenhuma carta" />
                            <Label fx:id="labelCartaJogadorStatus" styleClass="status-carta-campo" text="Escolha uma carta" />
                        </VBox>
                    </StackPane>
                </VBox>

                      <VBox alignment="CENTER" prefHeight="335.0" prefWidth="366.0" spacing="12.0">
         
                                   <HBox alignment="CENTER" prefHeight="57.0" prefWidth="686.0" spacing="20.0" styleClass="placar-faixa">
                     <Label styleClass="placar-label" text="SUAS CARTAS" />
                     <Label fx:id="labelVidaJogador" styleClass="vida-jogador" text="5" />
                     <Label styleClass="hud-versus" text="VS" />
                     <Label fx:id="labelVidaBot" styleClass="vida-bot" text="5" />
                     <Label styleClass="placar-label" text="CARTAS BOT" />
                 </HBox>
                    <HBox alignment="CENTER" spacing="10.0" />

                          <Button fx:id="botaoPassarTurno" onAction="#passarTurno" styleClass="botao-turno-central" text="PASSAR TURNO" />

                          <Button fx:id="botaoRender" onAction="#renderSe" styleClass="botao-batalha-secundario botao-render" text="RENDER-SE" />
                </VBox>
                <VBox alignment="CENTER" spacing="8.0">
                    <Label styleClass="titulo-slot" text="CARTA DO BOT" />
                    <StackPane fx:id="campoBot" maxHeight="312.0" maxWidth="212.0" minHeight="312.0" minWidth="212.0" prefHeight="312.0" prefWidth="212.0" styleClass="slot-carta-batalha">
                        <VBox alignment="CENTER" spacing="8.0">
                            <Label fx:id="labelCartaBotNome" styleClass="nome-carta-campo" text="Nenhuma carta" />
                            <Label fx:id="labelCartaBotStatus" styleClass="status-carta-campo" text="Aguardando..." />
                        </VBox>
                    </StackPane>
                </VBox>
            </HBox>
        </VBox>
   
              <VBox alignment="CENTER" prefHeight="243.0" prefWidth="1294.0" spacing="14.0" styleClass="painel-mao">
            <Label styleClass="titulo-mao" text="SUA MÃO" />
   
                  <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="AS_NEEDED" pannable="true" styleClass="scroll-mao" vbarPolicy="NEVER">
                <content>
                    <HBox fx:id="containerCartasJogador" alignment="CENTER" prefHeight="167.0" prefWidth="1270.0" spacing="20.0" styleClass="mao-jogador">
                        <padding>
                            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                        </padding>
                    </HBox>
                </content>
            </ScrollPane>
        </VBox>

          </VBox>

</StackPane>
