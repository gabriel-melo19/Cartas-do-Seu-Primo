<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.cardgame.ui.controller.JanelaBatalhaController"
           stylesheets="@../css/estilo_batalha.css"
           prefWidth="1366.0"
           prefHeight="768.0"
           styleClass="root-batalha">

    <StackPane fx:id="camadaFundo" styleClass="camada-fundo-batalha" />

    <VBox fx:id="containerPrincipal"
          alignment="TOP_CENTER"
          spacing="26.0"
          maxWidth="1400.0"
          styleClass="container-principal-batalha">

        <padding>
            <Insets top="26.0" right="36.0" bottom="24.0" left="36.0"/>
        </padding>

        <HBox alignment="CENTER" maxWidth="Infinity" styleClass="topo-batalha">
            <VBox alignment="CENTER_LEFT" spacing="4.0">
                <Label text="JOGADOR" styleClass="hud-label"/>
                <Label fx:id="labelNomeJogador" text="Antonio" styleClass="hud-nome"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <VBox alignment="CENTER" spacing="4.0">
                <Label text="BATALHA" styleClass="titulo-batalha"/>
                <Label fx:id="labelStatusTurno"
                       text="Escolha uma carta da sua mão."
                       styleClass="status-turno"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <VBox alignment="CENTER_RIGHT" spacing="6.0">
                <ImageView fx:id="imageBotPerfil"
                           fitWidth="74.0"
                           fitHeight="74.0"
                           preserveRatio="true"
                           pickOnBounds="true"
                           styleClass="imagem-bot-perfil"/>
                <Label text="ADVERSÁRIO" styleClass="hud-label"/>
                <Label fx:id="labelNomeBot" text="Boss" styleClass="hud-nome hud-nome-bot"/>
            </VBox>
        </HBox>

        <HBox alignment="CENTER" spacing="20.0" styleClass="placar-faixa">
            <Label text="SUAS CARTAS" styleClass="placar-label"/>
            <Label fx:id="labelVidaJogador" text="5" styleClass="vida-jogador"/>
            <Label text="VS" styleClass="hud-versus"/>
            <Label fx:id="labelVidaBot" text="5" styleClass="vida-bot"/>
            <Label text="CARTAS BOT" styleClass="placar-label"/>
        </HBox>

        <VBox alignment="CENTER" spacing="18.0" styleClass="arena-batalha-visual">

            <HBox alignment="CENTER" spacing="42.0" styleClass="linha-cartas-topo">
                <VBox alignment="CENTER" spacing="8.0">
                    <Label text="CARTA DO BOT" styleClass="titulo-slot"/>
                    <StackPane fx:id="campoBot"
                               prefWidth="212.0"
                               minWidth="212.0"
                               maxWidth="212.0"
                               prefHeight="312.0"
                               minHeight="312.0"
                               maxHeight="312.0"
                               styleClass="slot-carta-batalha">
                        <VBox alignment="CENTER" spacing="8.0">
                            <Label fx:id="labelCartaBotNome"
                                   text="Nenhuma carta"
                                   styleClass="nome-carta-campo"/>
                            <Label fx:id="labelCartaBotStatus"
                                   text="Aguardando..."
                                   styleClass="status-carta-campo"/>
                        </VBox>
                    </StackPane>
                </VBox>

                <VBox alignment="CENTER" spacing="12.0">
                    <HBox alignment="CENTER" spacing="10.0">
                        <VBox alignment="CENTER" spacing="3.0" styleClass="info-pill">
                            <Label text="SUA MÃO" styleClass="slot-info-label"/>
                            <Label fx:id="labelVidaJogadorArena" text="5" styleClass="slot-info-valor"/>
                        </VBox>

                        <VBox alignment="CENTER" spacing="3.0" styleClass="info-pill">
                            <Label text="BOT" styleClass="slot-info-label"/>
                            <Label fx:id="labelVidaBotArena" text="5" styleClass="slot-info-valor"/>
                        </VBox>
                    </HBox>

                    <Button fx:id="botaoPassarTurno"
                            text="PASSAR TURNO"
                            onAction="#passarTurno"
                            styleClass="botao-turno-central"/>

                    <Button fx:id="botaoRender"
                            text="RENDER-SE"
                            onAction="#renderSe"
                            styleClass="botao-batalha-secundario botao-render"/>
                </VBox>

                <VBox alignment="CENTER" spacing="8.0">
                    <Label text="SUA CARTA" styleClass="titulo-slot"/>
                    <StackPane fx:id="campoJogador"
                               prefWidth="212.0"
                               minWidth="212.0"
                               maxWidth="212.0"
                               prefHeight="312.0"
                               minHeight="312.0"
                               maxHeight="312.0"
                               styleClass="slot-carta-batalha slot-carta-jogador">
                        <VBox alignment="CENTER" spacing="8.0">
                            <Label fx:id="labelCartaJogadorNome"
                                   text="Nenhuma carta"
                                   styleClass="nome-carta-campo"/>
                            <Label fx:id="labelCartaJogadorStatus"
                                   text="Escolha uma carta"
                                   styleClass="status-carta-campo"/>
                        </VBox>
                    </StackPane>
                </VBox>
            </HBox>
        </VBox>

        <VBox alignment="CENTER" spacing="14.0" styleClass="painel-mao">
            <Label text="SUA MÃO" styleClass="titulo-mao"/>

            <ScrollPane fitToHeight="true"
                        fitToWidth="true"
                        hbarPolicy="AS_NEEDED"
                        vbarPolicy="NEVER"
                        pannable="true"
                        styleClass="scroll-mao">
                <content>
                    <HBox fx:id="containerCartasJogador"
                          alignment="CENTER"
                          spacing="20.0"
                          styleClass="mao-jogador">
                        <padding>
                            <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
                        </padding>
                    </HBox>
                </content>
            </ScrollPane>
        </VBox>

    </VBox>

</StackPane>