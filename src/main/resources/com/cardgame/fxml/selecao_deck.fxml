<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.cardgame.ui.controller.SelecaoDeckController"
           stylesheets="@../css/estilo_deck.css"
           pickOnBounds="false">

    <VBox fx:id="containerPrincipal"
          alignment="CENTER"
          spacing="35.0"
          maxWidth="1400.0">

        <padding>
            <Insets top="40.0" right="40.0" bottom="40.0" left="40.0"/>
        </padding>

        <Label fx:id="tituloTela"
               text="Escolha seu deck"
               styleClass="titulo-tela" />

        <FlowPane fx:id="painelListaDecks"
                  alignment="CENTER"
                  hgap="30.0"
                  vgap="25.0"
                  prefWrapLength="900.0"
                  styleClass="painel-lista-decks" />

        <VBox fx:id="painelDeckSelecionado"
              alignment="CENTER"
              spacing="30.0"
              visible="false"
              managed="false">

            <HBox fx:id="painelCartasDeck"
                  alignment="CENTER"
                  spacing="20.0"
                  styleClass="painel-cartas-deck" />

            <HBox alignment="CENTER" spacing="28.0">
                <Button fx:id="botaoConfirmarDeck"
                        text="CONFIRMAR DECK"
                        onAction="#confirmarDeckSelecionado"
                        styleClass="botao-acao-deck" />

                <Button fx:id="botaoSelecionarOutroDeck"
                        text="SELECIONAR OUTRO DECK"
                        onAction="#selecionarOutroDeck"
                        styleClass="botao-acao-deck" />
            </HBox>

        </VBox>

        <Button fx:id="botaoVoltar"
                text="VOLTAR"
                onAction="#voltarParaMenu"
                styleClass="botao-voltar" />

    </VBox>

    <!-- OVERLAY DETALHES DA CARTA -->
    <StackPane fx:id="overlayDetalhesCarta"
               alignment="CENTER"
               visible="false"
               managed="false"
               styleClass="overlay-detalhes-carta">

        <StackPane styleClass="overlay-fundo-escuro" />

        <VBox fx:id="janelaDetalhesCarta"
              alignment="TOP_CENTER"
              spacing="16.0"
              maxWidth="420.0"
              prefWidth="420.0"
              maxHeight="420.0"
              prefHeight="420.0"
              styleClass="janela-detalhes-carta">

            <HBox alignment="CENTER_RIGHT" maxWidth="Infinity">
                <Button fx:id="botaoFecharDetalhes"
                        text="✕"
                        onAction="#fecharDetalhesCarta"
                        styleClass="botao-fechar-detalhes" />
            </HBox>

            <Label fx:id="nomeDetalhesCarta"
                   text="Nome da carta"
                   wrapText="true"
                   styleClass="titulo-detalhes-carta" />

            <HBox alignment="CENTER" spacing="20.0">
                <Label fx:id="atkDetalhesCarta"
                       text="ATK: 0"
                       styleClass="status-detalhes-carta" />
                <Label fx:id="hpDetalhesCarta"
                       text="HP: 0"
                       styleClass="status-detalhes-carta" />
            </HBox>

            <Label text="Descrição"
                   styleClass="subtitulo-detalhes-carta" />

            <ScrollPane fitToWidth="true"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        prefViewportHeight="220.0"
                        styleClass="scroll-detalhes-carta">

                <content>
                    <Label fx:id="descricaoDetalhesCarta"
                           wrapText="true"
                           maxWidth="340.0"
                           styleClass="descricao-detalhes-carta" />
                </content>
            </ScrollPane>

        </VBox>

    </StackPane>

</StackPane>