<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.cardgame.ui.controller.NicknameController"
           stylesheets="@../css/estilo_menu.css"
           pickOnBounds="false">

    <VBox fx:id="painelNickname"
          alignment="CENTER"
          spacing="18.0">

        <Label text="Digite seu nickname"
               styleClass="label-instrucao" />

        <TextField fx:id="campoNickname"
                   promptText="seu nome aqui"
                   onAction="#confirmarNickname"
                   styleClass="campo-nickname" />

        <Label fx:id="labelDica"
               text="Pressione ENTER para continuar"
               styleClass="label-dica" />

        <Button fx:id="botaoVoltar"
                text="VOLTAR"
                onAction="#voltarParaMenu"
                styleClass="botao-voltar" />

    </VBox>

</StackPane>